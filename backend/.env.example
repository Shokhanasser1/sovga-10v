DEBUG=true
# Учебный режим: оплата, коды входа и Telegram без ключей — имитация. Для настоящего магазина — false
DEMO_MODE=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://shop:shop@localhost:5432/shop
# Telegram-бот: токен от @BotFather (только новый, после /revoke; файл .env не коммитится) и имя бота без @.
# Запуск — отдельное окно рядом с runserver: python manage.py run_bot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# CARD_COMMISSION_PCT=1.0
# Лимиты запросов к публичному API с одного посетителя
# THROTTLE_ANON=120/min
# THROTTLE_SEARCH=60/min
# TRUSTED_PROXIES=127.0.0.1,::1
# Тот же секрет, что INTERNAL_API_TOKEN в frontend/.env (длинная случайная строка)
# INTERNAL_API_TOKEN=
# Адреса витрины, которым разрешено читать API из браузера
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Коды входа (нужно хотя бы одно; без них при DEBUG=true код пишется в лог сервера)
# TELEGRAM_GATEWAY_TOKEN=
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# Только для сквозных тестов, только при DEBUG=true
# OTP_FIXED_CODE=000000
# Чаты менеджеров для уведомлений бота, через запятую (бот должен быть добавлен в чат)
# MANAGER_CHAT_IDS=
# Оплата: Payme (касса и ключ; для песочницы PAYME_CHECKOUT_URL=https://test.paycom.uz) и Click
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# Адрес витрины — сюда покупатель вернётся после оплаты
# SITE_URL=http://localhost:3000
# Срок возврата товара надлежащего качества, дней с доставки (уточнить у юриста)
# RETURN_DAYS=10
# Боевой режим (DEBUG=false): HSTS и уровень логов. Поддомены/preload — см. docs/deploy.md
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
# LOG_LEVEL=INFO
