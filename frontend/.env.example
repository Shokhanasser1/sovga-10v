# Адрес Django API для серверной отрисовки (по умолчанию http://127.0.0.1:8000)
API_URL=http://127.0.0.1:8000
# Адрес Django API для браузера. Локально — то же имя хоста, что у витрины (localhost), иначе
# браузер не отправит cookie входа. В проде — пусто: nginx отдаёт /api/ этого же сайта в Django.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Публичный адрес витрины — для sitemap.xml, robots.txt и ссылок между языками
SITE_URL=http://localhost:3000
# Тот же секрет, что INTERNAL_API_TOKEN в backend/.env. Без него серверные запросы витрины
# считаются как один посетитель и под нагрузкой упрутся в лимит Django.
# INTERNAL_API_TOKEN=
